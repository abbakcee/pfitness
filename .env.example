# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real secrets.

# ---- Frontend (safe to expose — these are public/anon-scoped) ----
# Find both in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# ---- Server-side only (Supabase Edge Function secrets) ----
# Set these with the Supabase CLI, NOT in this file:
#   supabase secrets set RESEND_API_KEY=your_resend_key
#   supabase secrets set RESEND_FROM_ADDRESS="P-Fitness <noreply@yourdomain.com>"
#   supabase secrets set PUBLIC_SITE_URL=https://pfitness-website.vercel.app
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically
# for Edge Functions — you do not set those yourself.
